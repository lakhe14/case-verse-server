# Isolated E2E environment. Copy to server/.env.e2e.local (gitignored) only if
# you need to override a default. Never put real credentials here.
#
# NODE_ENV=e2e and E2E_ALLOW_DB_MUTATION=true are set by the npm scripts
# (e2e:db:setup, e2e:db:cleanup, e2e:db:reset, e2e:server, test:integration).
#
# Database: must end with _e2e or every E2E script and the E2E server refuse
# to start. Default: the dev MySQL host/account from .env with the database
# name replaced by caseverse_e2e.
# E2E_DATABASE_URL=mysql://user:password@127.0.0.1:3307/caseverse_e2e

# API port and allowed browser origins for the E2E Vite app.
# PORT=4010
# CLIENT_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Upload directories: must stay inside server/.tmp.
# UPLOAD_DIR=.tmp/e2e-uploads
# PRIVATE_UPLOAD_DIR=.tmp/e2e-payment-proofs

# Shipping: deterministic stub by default. Set to true for the optional live
# provider check (npm run test:integration -- parcelmooverLive).
# E2E_PARCELMOOVER_LIVE=true

# Fixture passwords (E2E-only defaults live in scripts/e2e/fixtureData.js).
# E2E_CUSTOMER_PASSWORD=
# E2E_CUSTOMER_B_PASSWORD=
# E2E_STAFF_PASSWORD=
# E2E_LIMITED_STAFF_PASSWORD=
