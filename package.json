{
  "name": "caseverse-server",
  "version": "1.0.0",
  "description": "REST API for the CaseVerse iPhone covers store",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/initDb.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/initDb.js --drop && node scripts/seed.js",
    "db:remove-legacy-bags": "node scripts/removeLegacyBags.js",
    "dev:reset-accounts": "node scripts/resetDevAccounts.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "ecommerce",
    "express",
    "sequelize",
    "mysql"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
