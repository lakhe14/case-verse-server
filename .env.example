# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MySQL: DATABASE_URL wins when present; otherwise the DB_* values are used.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=caseverse
DB_USER=root
DB_PASSWORD=change_me
# Test-only MySQL database. Required by `npm run test:integration`; its name
# must contain "test" and is never allowed to fall back to DB_NAME.
DB_TEST_NAME=caseverse_test
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_USER=root
DB_TEST_PASSWORD=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CA_CERT=

# Auth: use distinct secure random values outside local development.
JWT_ACCESS_SECRET=replace_with_secure_random_secret
JWT_REFRESH_SECRET=replace_with_secure_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Uploads and business rules
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
LOYALTY_EARN_RATE=0.02
LOYALTY_POINT_VALUE=1

# Order confirmation (public QR is served by the client; proofs remain private)
PAYMENT_ADVANCE_AMOUNT=100
# Staff review target for uploaded payment proofs. Display only ("Review overdue"):
# a proof awaiting review never expires and its order is never auto-cancelled.
PAYMENT_PROOF_REVIEW_SLA_HOURS=72
PAYMENT_PROVIDER=eSewa

# Inventory reservation retention (days) for `npm run inventory:prune-reservations`.
# released/expired rows use the first value, restocked rows the second;
# committed and active rows are never pruned.
INVENTORY_RESERVATION_RETENTION_DAYS=90
INVENTORY_RESTOCKED_RETENTION_DAYS=180

# Optional Redis read cache for public catalog data (server-only; never put it in
# client env files). Leave REDIS_URL empty to run without Redis; the API never
# requires it and falls back to MySQL whenever Redis is slow or unreachable.
# Use rediss:// (TLS) and credentials inside the URL in production. Recommended
# Redis settings for a dedicated cache: maxmemory set, maxmemory-policy allkeys-lru.
# The E2E environment only ever uses E2E_REDIS_URL, with its own key prefix.
REDIS_URL=
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_NEGATIVE_TTL_SECONDS=45
CACHE_PREFIX=caseverse

# ParcelMoover (server-only; never copy the API key into client environment files)
PARCELMOOVER_API_KEY=
PARCELMOOVER_BASE_URL=https://portal.parcelmoover.com/api/v1
PARCELMOOVER_DEFAULT_WEIGHT_KG=0.5

# LOCAL DEVELOPMENT ONLY. Required by `npm run dev:reset-accounts`.
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_USERNAME=AdminUser
DEV_ADMIN_PASSWORD=replace_with_local_dev_password
DEV_CUSTOMER_EMAIL=customer@example.test
DEV_CUSTOMER_USERNAME=CustomerUser
DEV_CUSTOMER_PASSWORD=replace_with_local_dev_password
